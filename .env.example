# ========== MySQL 数据库配置 ==========
MYSQL_HOST=192.168.3.12
MYSQL_PORT=3306
MYSQL_USER=xxx
MYSQL_PASSWORD=xxx
MYSQL_DATABASE=

# ========== LLM 配置 ==========
# OpenAI-compatible API 地址（DeepSeek / OpenAI / 其他兼容接口）
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1

# ========== Agent 配置 ==========
# 高危操作是否需要用户确认（true/false）
CONFIRM_HIGH_RISK=true
# 最大循环次数，防止无限循环
MAX_AGENT_LOOPS=20
